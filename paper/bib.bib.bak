@Article{Norton2002,
  author      = {Norton, P.},
  title       = {HgCdTe infrared detectors},
  journal     = {Opto - Electronics Review},
  year        = {2002},
  volume      = {Vol. 10, No. 3},
  pages       = {159-174},
  abstract    = {HgCdTe infrared detectors have been intensively developed over the past forty years since the first synthesis of this compound semiconductor in 1958. Today, HgCdTe is the most widely used infrared detector material. This paper reviews key developments in the crystal growth and device history of this important technology. Projections and challenges for the continued evolution of this technology are summarized},
  affiliation = {Santa Barbara Research Center, Raytheon Systems Company, 75 Coromar Drive, Goleta, CA 93117, USA},
  keywords    = {HgCdTe single crystals and epitaxial layers; HgCdTe photoconductors and photodiodes; focal plane arrays},
  language    = {English},
}

