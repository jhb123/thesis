\contentsline {chapter}{\numberline {A}Algorithm For Finding a Three Optic Solution with 45\si {\degree } Gouy Phase Separation between two of the Optics}{28}{appendix.A}
\contentsline {paragraph}{}{29}{section*.36}
\contentsline {paragraph}{}{29}{section*.37}
\contentsline {subsection}{\numberline {A.0.1}Method}{29}{subsection.A.0.1}
\contentsline {paragraph}{Define the target mode at the optic 3.}{30}{section*.38}
\contentsline {paragraph}{Define a set of modes which share the same beam size as the target mode at optic 3 but have varying radii of curvature.}{30}{section*.39}
\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{30}{section*.40}
\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{30}{section*.41}
\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{30}{section*.42}
\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{30}{section*.43}
\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{30}{section*.44}
\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{30}{section*.45}
\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{31}{section*.46}
\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{31}{section*.47}
\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{31}{section*.48}
\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{31}{section*.49}
\contentsline {paragraph}{}{31}{section*.50}
