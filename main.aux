\newlabel{sec:mode_match_to_arm}{{D.1}{275}{Mode Matching the Laser to the Arm Cavity}{section.D.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {D.1}{\ignorespaces Optimisation of the parameters used in the \texttt  {gauss} command to mode match the laser to the arms in the simulations described in Chapter\nobreakspace  {}\ref  {chapter:simulation_finesse} and Section\nobreakspace  {}\ref  {sec:finesse_code}. The blue, green and orange lines show how the mode matching changes as the beam waist location is changed. As the mode mismatch became larger, more \glspl {hom} were required; this is why the blue and green/orange lines diverge. A quadratic was fitted to the data highlighted in red, and the minimum value was used as the waist location parameter for the \texttt  {gauss} command.\relax }}{278}{figure.caption.132}}
\newlabel{fig:gausscommandfitting}{{D.1}{278}{Optimisation of the parameters used in the \texttt {gauss} command to mode match the laser to the arms in the simulations described in Chapter~\ref {chapter:simulation_finesse} and Section~\ref {sec:finesse_code}. The blue, green and orange lines show how the mode matching changes as the beam waist location is changed. As the mode mismatch became larger, more \glspl {hom} were required; this is why the blue and green/orange lines diverge. A quadratic was fitted to the data highlighted in red, and the minimum value was used as the waist location parameter for the \texttt {gauss} command.\relax }{figure.caption.132}{}}
