\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces A coherent state $\mathinner {|{\alpha }\delimiter "526930B }$, enters port $a$ of a beam splitter. A signal $\mathinner {|{\Psi }\delimiter "526930B }$ enters port $b$. These two beams interfere, resulting in photons being detected at the $c$ and $d$ ports. The two photo-currents are subtracted, and the signal that is produced is proportional to an arbitrary quadrature of the state$\mathinner {|{\Psi }\delimiter "526930B }$. The quadrature that is measured is determined by the homodyne angle, $\theta $. This is expressed mathematically by equation \ref  {eq:general_quadrature_BHD}.\relax }}{8}{figure.caption.9}}
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:bhdforligochapterbhdsketch}{{1.1}{8}{A coherent state $\ket {\alpha }$, enters port $a$ of a beam splitter. A signal $\ket {\Psi }$ enters port $b$. These two beams interfere, resulting in photons being detected at the $c$ and $d$ ports. The two photo-currents are subtracted, and the signal that is produced is proportional to an arbitrary quadrature of the state$\ket {\Psi }$. The quadrature that is measured is determined by the homodyne angle, $\theta $. This is expressed mathematically by equation \ref {eq:general_quadrature_BHD}.\relax }{figure.caption.9}{}}
\newlabel{eq:bhd_photonnumber}{{1.7}{9}{}{equation.1.1.7}{}}
