\@writefile{toc}{\contentsline {subsection}{\numberline {1.6.1}The Dependence of Dark Noise and Dark Current on Reverse Bias in Extended InGaAs Photodiodes}{25}{subsection.1.6.1}}
\@writefile{toc}{\contentsline {paragraph}{}{25}{section*.39}}
\@writefile{toc}{\contentsline {paragraph}{}{25}{section*.40}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces The dark noise of the FD10D increases as the reverse bias is increased. Above 0.6\tmspace  +\thinmuskip {.1667em}V, the dark noise of the FD10D would limit the noise of a 10\tmspace  +\thinmuskip {.1667em}mA current above 10\tmspace  +\thinmuskip {.1667em}Hz. As the noise spectral densities have no knees, the function $i_c/f^{\beta }$ can be fitted to the data. See appendix \ref  {sec:pd_appendix_bias_dark_noise} for the dark noise spectra of other photodiodes. Below 0.9\tmspace  +\thinmuskip {.1667em}V reverse bias, the spectra fall as $f^{-0.45}$ and above 0.9\tmspace  +\thinmuskip {.1667em}V bias the spectra fall as $f^{-0.4}$. The values for $\beta $ is typical for `$1/f$' noise \cite  {Hooge1981}. This data is shown in Figure \ref  {fig:pdchapterdarkcurrentmegaplot} alongside the results for the other photodiodes tested.\relax }}{26}{figure.caption.41}}
\newlabel{fig:pdchapterfd10ddarknoise}{{1.5}{26}{The dark noise of the FD10D increases as the reverse bias is increased. Above 0.6\,V, the dark noise of the FD10D would limit the noise of a 10\,mA current above 10\,Hz. As the noise spectral densities have no knees, the function $i_c/f^{\beta }$ can be fitted to the data. See appendix \ref {sec:pd_appendix_bias_dark_noise} for the dark noise spectra of other photodiodes. Below 0.9\,V reverse bias, the spectra fall as $f^{-0.45}$ and above 0.9\,V bias the spectra fall as $f^{-0.4}$. The values for $\beta $ is typical for `$1/f$' noise \cite {Hooge1981}. This data is shown in Figure \ref {fig:pdchapterdarkcurrentmegaplot} alongside the results for the other photodiodes tested.\relax }{figure.caption.41}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.6}{\ignorespaces Left panel: the dark current for each photodiode was measured. Photodiodes of a similar cut-off wavelength share the same marker shape. The 1\tmspace  +\thinmuskip {.1667em}mm photodiodes have larger markers than the 0.5\tmspace  +\thinmuskip {.1667em}mm photodiodes. Right panel: the dark noise at 10\tmspace  +\thinmuskip {.1667em}Hz for each photodiode. The dashed line indicates the level of shot noise for a 10\tmspace  +\thinmuskip {.1667em}mA current.\relax }}{27}{figure.caption.42}}
\newlabel{fig:pdchapterdarkcurrentmegaplot}{{1.6}{27}{Left panel: the dark current for each photodiode was measured. Photodiodes of a similar cut-off wavelength share the same marker shape. The 1\,mm photodiodes have larger markers than the 0.5\,mm photodiodes. Right panel: the dark noise at 10\,Hz for each photodiode. The dashed line indicates the level of shot noise for a 10\,mA current.\relax }{figure.caption.42}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.7}{\ignorespaces The difference in dark noise between two Hamamatsu photodiodes of the same kind (g12182-010k) under identical operating conditions (room temperature at 1\tmspace  +\thinmuskip {.1667em}V bias). Photodiode 2 performs nearly 100 times better than photodiode 1. \relax }}{28}{figure.caption.43}}
\newlabel{fig:pdchapterg12182-010knoisecompare}{{1.7}{28}{The difference in dark noise between two Hamamatsu photodiodes of the same kind (g12182-010k) under identical operating conditions (room temperature at 1\,V bias). Photodiode 2 performs nearly 100 times better than photodiode 1. \relax }{figure.caption.43}{}}
