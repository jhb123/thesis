\@writefile{lof}{\contentsline {figure}{\numberline {8.13}{\ignorespaces To investigate possible reasons why there was excess noise in the photocurrent produced by the IG24x500S4i, its ideality factor was measured (red points). Equation \ref  {eq:pd_chapter_ideality_factor} was used to do an unweighted fit to the data ($I_0 = (360\pm 10)\tmspace  +\thinmuskip {.1667em}\si {nA}$ and $n = 1.02\pm 0.01$). The IG24x500S4i was found to be close to ideal as $n$ was close to unity and so this does not provide clues to the source of excess noise in the photocurrent.\relax }}{114}{figure.caption.155}}
\newlabel{fig:pdchapterforwardbiasiv}{{8.13}{114}{To investigate possible reasons why there was excess noise in the photocurrent produced by the IG24x500S4i, its ideality factor was measured (red points). Equation \ref {eq:pd_chapter_ideality_factor} was used to do an unweighted fit to the data ($I_0 = (360\pm 10)\,\si {nA}$ and $n = 1.02\pm 0.01$). The IG24x500S4i was found to be close to ideal as $n$ was close to unity and so this does not provide clues to the source of excess noise in the photocurrent.\relax }{figure.caption.155}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.14}{\ignorespaces Different light levels were shone onto the photodiode and the current produced at 0.05\tmspace  +\thinmuskip {.1667em}V reverse bias was recorded. These measurements are shown by the stars. Based on the model obtained from the data shown in Figure \ref  {fig:pdchapterforwardbiasiv}, the current flowing through the photodiode was predicted (indicated by the lines). The model and the measurements are in agreement with each other although the photodiode may have been saturating for the 3.3\tmspace  +\thinmuskip {.1667em}mW measurement.\relax }}{115}{figure.caption.156}}
\newlabel{fig:pdchapterforwardbiasmodelwithlight}{{8.14}{115}{Different light levels were shone onto the photodiode and the current produced at 0.05\,V reverse bias was recorded. These measurements are shown by the stars. Based on the model obtained from the data shown in Figure \ref {fig:pdchapterforwardbiasiv}, the current flowing through the photodiode was predicted (indicated by the lines). The model and the measurements are in agreement with each other although the photodiode may have been saturating for the 3.3\,mW measurement.\relax }{figure.caption.156}{}}
