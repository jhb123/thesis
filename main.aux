\@writefile{lof}{\contentsline {figure}{\numberline {1.15}{\ignorespaces The P5968 had its cathode grounded and the noise of the photocurrent due to the blackbody radiation produced by room temperature aluminium was measured (red). The noise level of the photocurrent corresponds to shot noise (green). The noise of the transimpedance amplifier (blue) is well below the noise of photocurrents noise.\relax }}{38}{figure.caption.55}}
\newlabel{fig:pdchapterp5968noise}{{1.15}{38}{The P5968 had its cathode grounded and the noise of the photocurrent due to the blackbody radiation produced by room temperature aluminium was measured (red). The noise level of the photocurrent corresponds to shot noise (green). The noise of the transimpedance amplifier (blue) is well below the noise of photocurrents noise.\relax }{figure.caption.55}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.16}{\ignorespaces Left panel: the DC dark current of the P5968 as a function of bias. Middle panel: $1/f$ noise rose as the bias of the P5968 was increased (see Figure \ref  {fig:pdchapterinsbnoiseasfunctionofbias}). Right panel: At a frequency where $1/f$ was not present, the noise of the photocurrent was measured. The excess noise factor is the multiplicative factor that the shot noise corresponding to the DC photocurrent needs to be multiplied by get the noise level that was measured.\relax }}{39}{figure.caption.57}}
\newlabel{fig:pdchapterinsbbiased}{{1.16}{39}{Left panel: the DC dark current of the P5968 as a function of bias. Middle panel: $1/f$ noise rose as the bias of the P5968 was increased (see Figure \ref {fig:pdchapterinsbnoiseasfunctionofbias}). Right panel: At a frequency where $1/f$ was not present, the noise of the photocurrent was measured. The excess noise factor is the multiplicative factor that the shot noise corresponding to the DC photocurrent needs to be multiplied by get the noise level that was measured.\relax }{figure.caption.57}{}}
