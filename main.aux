\@writefile{lof}{\contentsline {figure}{\numberline {B.1}{\ignorespaces Circuit used to measure the dark noise of photodiodes, represented by \textsc  {Test\_PD}, under different reverse biases. The transimpedance amplifier has a 1\si {\mega \ohm } (R2) in parallel with a 2.2\si {\pico \farad } capacitor (C2) in the feedback path of the TL071 op amp (TL071P). The reverse bias was generated by a potentiometer (R1) connected to an LM7815 voltage regulator. This voltage was low passed using C1\relax }}{57}{figure.caption.88}}
\newlabel{fig:circuitappendixdarknoisetestbox1}{{B.1}{57}{Circuit used to measure the dark noise of photodiodes, represented by \textsc {Test\_PD}, under different reverse biases. The transimpedance amplifier has a 1\si {\mega \ohm } (R2) in parallel with a 2.2\si {\pico \farad } capacitor (C2) in the feedback path of the TL071 op amp (TL071P). The reverse bias was generated by a potentiometer (R1) connected to an LM7815 voltage regulator. This voltage was low passed using C1\relax }{figure.caption.88}{}}
\@writefile{toc}{\contentsline {paragraph}{}{57}{section*.87}}
\@writefile{toc}{\contentsline {paragraph}{}{57}{section*.90}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.2}{\ignorespaces Circuit used to measure the dark noise of photodiodes. The transimpedance amplifier used is identical to the one shown in Figure \ref  {fig:circuitappendixdarknoisetestbox1} .The bias voltage was generated using an OP27 op amp (OP27D) configured with so that the gain between the inverting input and the output of OP27D was $>1$.\relax }}{58}{figure.caption.89}}
\newlabel{fig:circuitappendixdarknoisetestbox3}{{B.2}{58}{Circuit used to measure the dark noise of photodiodes. The transimpedance amplifier used is identical to the one shown in Figure \ref {fig:circuitappendixdarknoisetestbox1} .The bias voltage was generated using an OP27 op amp (OP27D) configured with so that the gain between the inverting input and the output of OP27D was $>1$.\relax }{figure.caption.89}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.3}{\ignorespaces Circuit used to check that bias voltage noise was not contaminating dark noise measurements. To reach $5\si {\nano \volt /\sqrt  {\hertz }}$ at 10\tmspace  +\thinmuskip {.1667em}Hz, a 10V low noise reference IC (AD587JNZ) was used to generate the reverse bias. The output of this IC was filtered by two low pass filters (IC1A and IC2A). The transimpedance amplifier used is identical to the one shown in Figure \ref  {fig:circuitappendixdarknoisetestbox1}\relax }}{59}{figure.caption.91}}
\newlabel{fig:circuitappendixdarknoisetestbox2}{{B.3}{59}{Circuit used to check that bias voltage noise was not contaminating dark noise measurements. To reach $5\si {\nano \volt /\sqrt {\hertz }}$ at 10\,Hz, a 10V low noise reference IC (AD587JNZ) was used to generate the reverse bias. The output of this IC was filtered by two low pass filters (IC1A and IC2A). The transimpedance amplifier used is identical to the one shown in Figure \ref {fig:circuitappendixdarknoisetestbox1}\relax }{figure.caption.91}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {B.1.1}Transfer function}{59}{subsection.B.1.1}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.4}{\ignorespaces The FD10D was biased with 1\tmspace  +\thinmuskip {.1667em}V in the circuits shown in Figure \ref  {fig:circuitappendixdarknoisetestbox1} and Figure \ref  {fig:circuitappendixdarknoisetestbox3}. The low noise fixed bias circuit and the circuit with a settable bias gave the same results, so we can be confident that the circuits shown in Figures \ref  {fig:circuitappendixdarknoisetestbox1} and \ref  {fig:circuitappendixdarknoisetestbox2} will produce measurements that are not contaminated by bias noise.\relax }}{60}{figure.caption.92}}
\newlabel{fig:pdchapterbiascrosscheck}{{B.4}{60}{The FD10D was biased with 1\,V in the circuits shown in Figure \ref {fig:circuitappendixdarknoisetestbox1} and Figure \ref {fig:circuitappendixdarknoisetestbox3}. The low noise fixed bias circuit and the circuit with a settable bias gave the same results, so we can be confident that the circuits shown in Figures \ref {fig:circuitappendixdarknoisetestbox1} and \ref {fig:circuitappendixdarknoisetestbox2} will produce measurements that are not contaminated by bias noise.\relax }{figure.caption.92}{}}
