\@writefile{lof}{\contentsline {figure}{\numberline {2.5}{\ignorespaces The Gaussian width of the beam that is transmitted through the SRM as a function of the error ($\pm 3\sigma $) in focal length of SR3 and SR2. The Gaussian beam width is strongly dependent on the error in SR3's focal length, whereas SR2's focal length error is less important. When the SR3 focal length error $>6\tmspace  +\thinmuskip {.1667em}\rm  {mm}$ and SR2 error is zero the SRC cavity is unstable (see figure \ref  {fig:maxtemexperiment}), so this area of the parameter space is unlikely to correspond to the beam at the SRM at LLO.\relax }}{41}{figure.caption.53}}
\newlabel{fig:beamsizesimulated}{{2.5}{41}{The Gaussian width of the beam that is transmitted through the SRM as a function of the error ($\pm 3\sigma $) in focal length of SR3 and SR2. The Gaussian beam width is strongly dependent on the error in SR3's focal length, whereas SR2's focal length error is less important. When the SR3 focal length error $>6\,\rm {mm}$ and SR2 error is zero the SRC cavity is unstable (see figure \ref {fig:maxtemexperiment}), so this area of the parameter space is unlikely to correspond to the beam at the SRM at LLO.\relax }{figure.caption.53}{}}
\@writefile{toc}{\contentsline {paragraph}{}{41}{section*.55}}
\citation{SRC_gouy_phase_meas_2018}
\citation{SRC_gouy_phase_meas_2018}
\@writefile{lof}{\contentsline {figure}{\numberline {2.6}{\ignorespaces The RoC of the beam that is transmitted through the SRM as a function of the error ($\pm 3\sigma $) in focal length of SR3 and SR2. If the arm cavities and the SRC are well mode matched, then the RoC of the beam transmitted through the SRM would be $\frac  {5.67\rm  {m}}{1.45} = 3.91\rm  {m}$. When the SR3 focal length error $>6\tmspace  +\thinmuskip {.1667em}\rm  {mm}$ and SR2 error is zero the SRC cavity is unstable (see figure \ref  {fig:maxtemexperiment}), so this area of the parameter space is unlikely to correspond to the beam at the SRM at LLO.\relax }}{42}{figure.caption.54}}
\newlabel{fig:beamrocsimulated}{{2.6}{42}{The RoC of the beam that is transmitted through the SRM as a function of the error ($\pm 3\sigma $) in focal length of SR3 and SR2. If the arm cavities and the SRC are well mode matched, then the RoC of the beam transmitted through the SRM would be $\frac {5.67\rm {m}}{1.45} = 3.91\rm {m}$. When the SR3 focal length error $>6\,\rm {mm}$ and SR2 error is zero the SRC cavity is unstable (see figure \ref {fig:maxtemexperiment}), so this area of the parameter space is unlikely to correspond to the beam at the SRM at LLO.\relax }{figure.caption.54}{}}
\@writefile{toc}{\contentsline {paragraph}{}{43}{section*.56}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.7}{\ignorespaces Gouy phase between the ITMs and the SRM as a function of the error ($\pm 3\sigma $) in SR3 and SR2. When the SR3 focal length error $>6\tmspace  +\thinmuskip {.1667em}\rm  {mm}$ and SR2 error is zero the SRC cavity is unstable (see figure \ref  {fig:maxtemexperiment}), so this area of the parameter space is unlikely to correspond to the beam at the SRM at LLO.\relax }}{43}{figure.caption.57}}
\newlabel{fig:gouyphasesr2sr3}{{2.7}{43}{Gouy phase between the ITMs and the SRM as a function of the error ($\pm 3\sigma $) in SR3 and SR2. When the SR3 focal length error $>6\,\rm {mm}$ and SR2 error is zero the SRC cavity is unstable (see figure \ref {fig:maxtemexperiment}), so this area of the parameter space is unlikely to correspond to the beam at the SRM at LLO.\relax }{figure.caption.57}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.8}{\ignorespaces Gouy phase between the ITMs and the SRM as a function of the thermal lens in the ITMs for nominal values of SR3 and SR2. The nominal ITM thermal lens is $50\tmspace  +\thinmuskip {.1667em}\rm  {km}$, and this corresponds to about 19\si {\degree }. More heating results in a greater thermal lens, however at at LIGO this is compensated for by the thermal compensation system (TCS).\relax }}{44}{figure.caption.58}}
\newlabel{fig:itmtl}{{2.8}{44}{Gouy phase between the ITMs and the SRM as a function of the thermal lens in the ITMs for nominal values of SR3 and SR2. The nominal ITM thermal lens is $50\,\rm {km}$, and this corresponds to about 19\si {\degree }. More heating results in a greater thermal lens, however at at LIGO this is compensated for by the thermal compensation system (TCS).\relax }{figure.caption.58}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.9}{\ignorespaces The percentage of HG00 light transmitted through the SRM as a function of SR3 focal length for the Michelson interferometer with Fabry\hyp  {}Perot cavities in its arms was simulated. Each simulation used a different \texttt  {maxtem} command. The focal length of SR3 was changed. For focal lengths with a positive error greater than 7.5\tmspace  +\thinmuskip {.1667em}mm, the cavity becomes unstable and \textsc  {Finesse} does not produce reliable results. For a stable SRC, the minimum number of TEM modes for sub 1\% accuracy is six.\relax }}{45}{figure.caption.59}}
\newlabel{fig:maxtemexperiment}{{2.9}{45}{The percentage of HG00 light transmitted through the SRM as a function of SR3 focal length for the Michelson interferometer with Fabry\hyp {}Perot cavities in its arms was simulated. Each simulation used a different \texttt {maxtem} command. The focal length of SR3 was changed. For focal lengths with a positive error greater than 7.5\,mm, the cavity becomes unstable and \textsc {Finesse} does not produce reliable results. For a stable SRC, the minimum number of TEM modes for sub 1\% accuracy is six.\relax }{figure.caption.59}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.10}{\ignorespaces The measurement error of SR3 and SR2 follows a normal distribution. These were combined to make a 2\hyp  {}D normal distribution. Dark blue corresponds to the least likely combinations of SR3 and SR2, and bright yellow corresponds to the most likely. The measured Gouy phase was 21.3\si {\degree }\cite  {SRC_gouy_phase_meas_2018}, this is indicated by the white dashed line. The white circle marks the most likely combination of SR3 and SR2 which gives 21.3\si {\degree } of Gouy phase, and the white crosses show 1 standard deviation from this. The white circle and crosses indicate that the focal length of SR2 is $-3.205\pm 0.003$\tmspace  +\thinmuskip {.1667em}m and the focal length of SR3 is $17.971\pm 0.002$\tmspace  +\thinmuskip {.1667em}m.\relax }}{46}{figure.caption.60}}
\newlabel{fig:sr3sr2likelyvalues}{{2.10}{46}{The measurement error of SR3 and SR2 follows a normal distribution. These were combined to make a 2\hyp {}D normal distribution. Dark blue corresponds to the least likely combinations of SR3 and SR2, and bright yellow corresponds to the most likely. The measured Gouy phase was 21.3\si {\degree }\cite {SRC_gouy_phase_meas_2018}, this is indicated by the white dashed line. The white circle marks the most likely combination of SR3 and SR2 which gives 21.3\si {\degree } of Gouy phase, and the white crosses show 1 standard deviation from this. The white circle and crosses indicate that the focal length of SR2 is $-3.205\pm 0.003$\,m and the focal length of SR3 is $17.971\pm 0.002$\,m.\relax }{figure.caption.60}{}}
