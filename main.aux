\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Comparison between the phase of the light reflected from a mirror versus the phase of light reflected from a cavity as the position of the mirror/end mirror is changed. The orange line shows the extra round trip phase acquired by light in the arm if the ETM is moved one wavelength (\ang {360}) and the blue line shows the same thing except for an Fabry-Perot cavity. The phase of the light reflected from the cavity rapidly changes as it moves through the resonance. The interferometers sensitivity is proportional to the slope $\frac  {d \phi _{\rm  {EM}}}{d \phi _{\rm  {ETM}}}$, and so a Fabry-Perot cavity can increase the sensitivity of the interferometer.\relax }}{21}{figure.caption.14}}
\newlabel{fig:detectorchapterfabryvsmirror}{{2.2}{21}{Comparison between the phase of the light reflected from a mirror versus the phase of light reflected from a cavity as the position of the mirror/end mirror is changed. The orange line shows the extra round trip phase acquired by light in the arm if the ETM is moved one wavelength (\ang {360}) and the blue line shows the same thing except for an Fabry-Perot cavity. The phase of the light reflected from the cavity rapidly changes as it moves through the resonance. The interferometers sensitivity is proportional to the slope $\frac {d \phi _{\rm {EM}}}{d \phi _{\rm {ETM}}}$, and so a Fabry-Perot cavity can increase the sensitivity of the interferometer.\relax }{figure.caption.14}{}}
\newlabel{eq:phase_photon_number_relation}{{2.9}{22}{Laser Power and Shot Noise}{equation.2.4.9}{}}
