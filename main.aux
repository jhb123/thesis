\@writefile{lof}{\contentsline {figure}{\numberline {6.15}{\ignorespaces The P5968 InSb detector had its cathode grounded, and the noise of the photocurrent due to the blackbody radiation produced by room temperature aluminium was measured (red). The expected level of photocurrent was calculated to be 5.5\tmspace  +\thinmuskip {.1667em}\si {\micro \ampere } and the measured photocurrent was 5.3\tmspace  +\thinmuskip {.1667em}\si {\micro \ampere }. The noise of the photocurrent corresponds to shot noise (green). The noise of the transimpedance amplifier (blue) is well below the shot noise of the photocurrent.\relax }}{205}{figure.caption.89}}
\newlabel{fig:pdchapterp5968noise}{{6.15}{205}{The P5968 InSb detector had its cathode grounded, and the noise of the photocurrent due to the blackbody radiation produced by room temperature aluminium was measured (red). The expected level of photocurrent was calculated to be 5.5\,\si {\micro \ampere } and the measured photocurrent was 5.3\,\si {\micro \ampere }. The noise of the photocurrent corresponds to shot noise (green). The noise of the transimpedance amplifier (blue) is well below the shot noise of the photocurrent.\relax }{figure.caption.89}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.16}{\ignorespaces Left panel: the DC dark current of the P5968 as a function of bias. Middle panel: $1/f$ noise rose as the bias of the P5968 was increased (see Figure\nobreakspace  {}\ref  {fig:pdchapterinsbnoiseasfunctionofbias}). Right panel: At a frequency where $1/f$ was not present, the noise of the photocurrent was measured. The excess noise factor is the multiplicative factor that the shot noise corresponding to the DC photocurrent needs to be multiplied by to get the noise level that was measured.\relax }}{206}{figure.caption.90}}
\newlabel{fig:pdchapterinsbbiased}{{6.16}{206}{Left panel: the DC dark current of the P5968 as a function of bias. Middle panel: $1/f$ noise rose as the bias of the P5968 was increased (see Figure~\ref {fig:pdchapterinsbnoiseasfunctionofbias}). Right panel: At a frequency where $1/f$ was not present, the noise of the photocurrent was measured. The excess noise factor is the multiplicative factor that the shot noise corresponding to the DC photocurrent needs to be multiplied by to get the noise level that was measured.\relax }{figure.caption.90}{}}
