\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Optimisation of parameters used in the \texttt  {gauss} command to mode match the laser to the arms in the simulations described in chapter \ref  {chapter:simulation_finesse} and section \ref  {sec:finesse_code}. The blue, green and orange lines show how the mode matching changes as the beam waist location is changed. As the mode matching becomes larger, more HOM are required, as the blue and green/orange lines diverge. A quadratic was fitted to the data highlighted in red, and the minimum value was used as the waist location parameter for the \texttt  {gauss} command.\relax }}{50}{figure.caption.86}}
\newlabel{fig:gausscommandfitting}{{14}{50}{Optimisation of parameters used in the \texttt {gauss} command to mode match the laser to the arms in the simulations described in chapter \ref {chapter:simulation_finesse} and section \ref {sec:finesse_code}. The blue, green and orange lines show how the mode matching changes as the beam waist location is changed. As the mode matching becomes larger, more HOM are required, as the blue and green/orange lines diverge. A quadratic was fitted to the data highlighted in red, and the minimum value was used as the waist location parameter for the \texttt {gauss} command.\relax }{figure.caption.86}{}}
