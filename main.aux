\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\newlabel{sec:algorithm_principle}{{B}{68}{Algorithm For Finding a Three Optic Solution with 45\si {\degree } Gouy Phase Separation between two of the Optics}{appendix.B}{}}
\@writefile{toc}{\contentsline {paragraph}{}{69}{section*.80}}
\@writefile{toc}{\contentsline {paragraph}{}{69}{section*.81}}
\@writefile{toc}{\contentsline {subsection}{\numberline {B.0.1}Method}{69}{subsection.B.0.1}}
\@writefile{toc}{\contentsline {paragraph}{Define the target mode at the optic 3.}{70}{section*.82}}
\@writefile{toc}{\contentsline {paragraph}{Define a set of modes which share the same beam size as the target mode at optic 3 but have varying radii of curvature.}{70}{section*.83}}
\@writefile{toc}{\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{70}{section*.84}}
\@writefile{toc}{\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{70}{section*.85}}
\@writefile{toc}{\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{70}{section*.86}}
\@writefile{toc}{\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{70}{section*.87}}
\@writefile{toc}{\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{70}{section*.88}}
\@writefile{toc}{\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{70}{section*.89}}
\bibdata{C:/bibliography/bibliography.bib}
\@writefile{toc}{\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{71}{section*.90}}
\@writefile{toc}{\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{71}{section*.91}}
\@writefile{toc}{\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{71}{section*.92}}
\@writefile{toc}{\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{71}{section*.93}}
\@writefile{toc}{\contentsline {paragraph}{}{71}{section*.94}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.1}{\ignorespaces Top layout: Three lenses used to achieve mode matching to the cavity. These are shown as positive lenses, however negative lenses can also be used when designing mode matching systems. Bottom Layout: A lens and two curved mirrors to achieve mode matching to a cavity. The optics 1,2 and 3 correspond to the ones shown in figure \ref  {fig:algorithmsketch}. The initial and target modes are defined in these examples by the laser mode and the cavity mode.\relax }}{72}{figure.caption.95}}
\newlabel{fig:opticallayouts}{{B.1}{72}{Top layout: Three lenses used to achieve mode matching to the cavity. These are shown as positive lenses, however negative lenses can also be used when designing mode matching systems. Bottom Layout: A lens and two curved mirrors to achieve mode matching to a cavity. The optics 1,2 and 3 correspond to the ones shown in figure \ref {fig:algorithmsketch}. The initial and target modes are defined in these examples by the laser mode and the cavity mode.\relax }{figure.caption.95}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.2}{\ignorespaces Sketch of the WS phase space representations of a Gaussian beams at the three positions along the optical axis where a mirror or a lens could be. Examples of such layouts are shown in figure \ref  {fig:opticallayouts}. The optical power of the first optic is given by the difference in the defocus between the initial mode (i) and the second mode (j). The power of the second optic is found by finding the difference in defocus from the blue-green continuum to the red-yellow continuum. There are 2 optical powers that will move the mode j to the red-yellow continuum, and two possible modes in the blue-green continuum that can from which k can be reached, giving 4 possible similar solutions. The algorithm can be set up so that it is only one way of moving between the blue-green and red-yellow continua by limiting their extent. The power of the third optic is found from the difference between the mode k and mode l at optic 3.\relax }}{73}{figure.caption.96}}
\newlabel{fig:algorithmsketch}{{B.2}{73}{Sketch of the WS phase space representations of a Gaussian beams at the three positions along the optical axis where a mirror or a lens could be. Examples of such layouts are shown in figure \ref {fig:opticallayouts}. The optical power of the first optic is given by the difference in the defocus between the initial mode (i) and the second mode (j). The power of the second optic is found by finding the difference in defocus from the blue-green continuum to the red-yellow continuum. There are 2 optical powers that will move the mode j to the red-yellow continuum, and two possible modes in the blue-green continuum that can from which k can be reached, giving 4 possible similar solutions. The algorithm can be set up so that it is only one way of moving between the blue-green and red-yellow continua by limiting their extent. The power of the third optic is found from the difference between the mode k and mode l at optic 3.\relax }{figure.caption.96}{}}
