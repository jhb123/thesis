\@writefile{toc}{\contentsline {subsection}{\numberline {1.2.4}The Effect of Misalignment on the Size of a Signal in an Interferometer}{20}{subsection.1.2.4}}
\newlabel{eq:MZ_chapter_misalignment}{{1.6}{20}{The Effect of Misalignment on the Size of a Signal in an Interferometer}{equation.1.2.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.11}{\ignorespaces Large amounts of scattering caused there to be a high amount of noise in the differential arm length signal's noise floor, this can be seen to limit the noise above $\sim 200$\tmspace  +\thinmuskip {.1667em}Hz. The effect of the pendulums resonance at $\sim 1\tmspace  +\thinmuskip {.1667em}Hz$ was mostly removed by the servo but it can still be seen in the noise. Many suspension related peaks can be seen around 30\tmspace  +\thinmuskip {.1667em}Hz, these are due to the design of the BHD suspension. The $1/f^4$ slope is due to the suspension having two stages. For this measurement, shot noise would have been at $\sim 10^{-15}\tmspace  +\thinmuskip {.1667em}\rm  {m}/\sqrt  {\rm  {Hz}}$.\relax }}{21}{figure.caption.27}}
\newlabel{fig:mzchaptersuspendeddiffarm}{{1.11}{21}{Large amounts of scattering caused there to be a high amount of noise in the differential arm length signal's noise floor, this can be seen to limit the noise above $\sim 200$\,Hz. The effect of the pendulums resonance at $\sim 1\,Hz$ was mostly removed by the servo but it can still be seen in the noise. Many suspension related peaks can be seen around 30\,Hz, these are due to the design of the BHD suspension. The $1/f^4$ slope is due to the suspension having two stages. For this measurement, shot noise would have been at $\sim 10^{-15}\,\rm {m}/\sqrt {\rm {Hz}}$.\relax }{figure.caption.27}{}}
