\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces Optical layout used for measuring the effect that increasing the reverse bias of a photodiode has on its quantum efficiency and saturation limit. The out-of-loop photodiode, $\rm  {PD_{OOL}}$, was the photodiode under test. A 1550\tmspace  +\thinmuskip {.1667em}nm laser was used to test the optical properties of the photodiode. A combination of half wave plate (HWP) and polarised beam splitter (PBS) allowed for the power of the beam to be set and a lens was used to set the size of the beam on the photodiode under test. Amplitude stabilised light was needed to ensure the increase in photocurrent seen when the bias increased was due to an increase in quantum efficiency. The photodiode circuit (TIA) (see Appendix \ref  {sec:circuits_appendix_variable_bias_ad797}) allowed for shot noise limited measurements of currents around 10\tmspace  +\thinmuskip {.1667em}mA and for the bias to be selected.\relax }}{18}{figure.caption.27}}
\newlabel{fig:pdchaptershotnoisetestsetup}{{1.1}{18}{Optical layout used for measuring the effect that increasing the reverse bias of a photodiode has on its quantum efficiency and saturation limit. The out-of-loop photodiode, $\rm {PD_{OOL}}$, was the photodiode under test. A 1550\,nm laser was used to test the optical properties of the photodiode. A combination of half wave plate (HWP) and polarised beam splitter (PBS) allowed for the power of the beam to be set and a lens was used to set the size of the beam on the photodiode under test. Amplitude stabilised light was needed to ensure the increase in photocurrent seen when the bias increased was due to an increase in quantum efficiency. The photodiode circuit (TIA) (see Appendix \ref {sec:circuits_appendix_variable_bias_ad797}) allowed for shot noise limited measurements of currents around 10\,mA and for the bias to be selected.\relax }{figure.caption.27}{}}
\@writefile{toc}{\contentsline {paragraph}{}{19}{section*.30}}
\newlabel{eq:pd_chapter_noise_budget}{{1.3}{19}{}{equation.1.5.3}{}}
