\@writefile{toc}{\contentsline {section}{\numberline {8.6}The Saturation Limit of the IG24x500S4i and IG26x500S4i}{218}{section.8.6}}
\newlabel{sec:pdchapterlasercomponentssaturation}{{8.6}{218}{The Saturation Limit of the IG24x500S4i and IG26x500S4i}{section.8.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.9}{\ignorespaces Left panel: the dark current for each photodiode at their maximum datasheet-specified reverse bias as a function of temperature. The measurement of the DC dark current approached the resolution of the multimeter around 1\tmspace  +\thinmuskip {.1667em}\si {\nano \ampere }. Exponentials were fitted to the data. Photodiodes with similar cut-off wavelengths share marker shapes, and 1\tmspace  +\thinmuskip {.1667em}mm photodiodes have larger markers than the 0.5\tmspace  +\thinmuskip {.1667em}mm ones. Right panel: the dark noise of each photodiode was measured as a function of temperature. The black dashed line indicates the shot noise level for a 10\tmspace  +\thinmuskip {.1667em}mA current. At 10\tmspace  +\thinmuskip {.1667em}Hz, the measurements for the IG24x500S4i did not change much as the temperature changed, there was a knee around this frequency (see Figure\nobreakspace  {}\ref  {fig:pdappendixig24temperaturenoisecurrent}); the noise of the IG24x500S4i was $600-700\tmspace  +\thinmuskip {.1667em}\si {\pico \ampere /\sqrt  {\hertz }}$ at 10\tmspace  +\thinmuskip {.1667em}Hz.\relax }}{219}{figure.caption.262}}
\newlabel{fig:pdchapterdarkcurrenttermperaturealldiodes}{{8.9}{219}{Left panel: the dark current for each photodiode at their maximum datasheet-specified reverse bias as a function of temperature. The measurement of the DC dark current approached the resolution of the multimeter around 1\,\si {\nano \ampere }. Exponentials were fitted to the data. Photodiodes with similar cut-off wavelengths share marker shapes, and 1\,mm photodiodes have larger markers than the 0.5\,mm ones. Right panel: the dark noise of each photodiode was measured as a function of temperature. The black dashed line indicates the shot noise level for a 10\,mA current. At 10\,Hz, the measurements for the IG24x500S4i did not change much as the temperature changed, there was a knee around this frequency (see Figure~\ref {fig:pdappendixig24temperaturenoisecurrent}); the noise of the IG24x500S4i was $600-700\,\si {\pico \ampere /\sqrt {\hertz }}$ at 10\,Hz.\relax }{figure.caption.262}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.10}{\ignorespaces The saturation limit of three Laser Components photodiodes was measured. The photodiodes were biased so that their noise at 10\tmspace  +\thinmuskip {.1667em}Hz was equal to the shot noise of a 10\tmspace  +\thinmuskip {.1667em}mA current. The IG24x500S4i and IG26x500S4i were exposed to a beam whose $3\sigma $ width was 220\tmspace  +\thinmuskip {.1667em}\si {\micro \metre } and the IG22x1000S4i was exposed to a beam whose $3\sigma $ width was 1000\tmspace  +\thinmuskip {.1667em}\si {\micro \metre }. The size of the light modulation of known size was tracked as the DC photocurrent was increased. As the photodiodes saturated, the relative size of the AC signal decreased. These photodiodes had low saturation limits compared to the FD10D, which showed no signs of saturation up to 16.5\tmspace  +\thinmuskip {.1667em}mA (see Figure\nobreakspace  {}\ref  {fig:pdchapterfd10dacdc}).\relax }}{220}{figure.caption.263}}
\newlabel{fig:pdchapterlasercomponentsratio}{{8.10}{220}{The saturation limit of three Laser Components photodiodes was measured. The photodiodes were biased so that their noise at 10\,Hz was equal to the shot noise of a 10\,mA current. The IG24x500S4i and IG26x500S4i were exposed to a beam whose $3\sigma $ width was 220\,\si {\micro \metre } and the IG22x1000S4i was exposed to a beam whose $3\sigma $ width was 1000\,\si {\micro \metre }. The size of the light modulation of known size was tracked as the DC photocurrent was increased. As the photodiodes saturated, the relative size of the AC signal decreased. These photodiodes had low saturation limits compared to the FD10D, which showed no signs of saturation up to 16.5\,mA (see Figure~\ref {fig:pdchapterfd10dacdc}).\relax }{figure.caption.263}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8.7}Excess Noise in the Photocurrent made by the IG24x500S4i}{221}{section.8.7}}
\newlabel{eq:pd_chapter_ideality_factor}{{8.4}{221}{Excess Noise in the Photocurrent made by the IG24x500S4i}{equation.8.7.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.11}{\ignorespaces The noise of a 1.3\tmspace  +\thinmuskip {.1667em}mA photocurrent made by the IG24x500S4i (blue) exceeded the expected amount (red) based on Equation\nobreakspace  {}\ref  {eq:pd_chapter_noise_budget} by a factor of $1.75$. Note that the height of the 1111\tmspace  +\thinmuskip {.1667em}Hz peak cannot be expressed in terms of amplitude spectral density units; however, this peak was measured to be the right level and so this beam was not saturating the photodiode. \relax }}{223}{figure.caption.264}}
\newlabel{fig:pdchaptershotnoiseproblemig24}{{8.11}{223}{The noise of a 1.3\,mA photocurrent made by the IG24x500S4i (blue) exceeded the expected amount (red) based on Equation~\ref {eq:pd_chapter_noise_budget} by a factor of $1.75$. Note that the height of the 1111\,Hz peak cannot be expressed in terms of amplitude spectral density units; however, this peak was measured to be the right level and so this beam was not saturating the photodiode. \relax }{figure.caption.264}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.12}{\ignorespaces A noise projection measurement was performed to determine if the excess noise in the photocurrent produced by the IG24x500S4i (see Figure\nobreakspace  {}\ref  {fig:pdchaptershotnoiseproblemig24}) was due to bias noise. The left hand panels show the Bode plot of the transfer function between the photodiode's cathode and the output of the transimpedance amplifier when the photodiode was producing 1.3\tmspace  +\thinmuskip {.1667em}mA of photocurrent. The right hand panel shows the effect of subtracting bias noise from the signal at the output of the transimpedance amplifier. The peak at 1121\tmspace  +\thinmuskip {.1667em}Hz was a modulation applied to the photodiode's cathode; 42.5\tmspace  +\thinmuskip {.1667em}dB of this signal was removed, which is in close agreement with the amount expected from the measured transfer function, by using the noise projection technique. However, the level of the broadband noise remained unchanged thus indicating that the excess noise witnessed in the photocurrent produced by the IG24x500S4i was not due to bias noise.\relax }}{224}{figure.caption.265}}
\newlabel{fig:pdchapternoiseprojection}{{8.12}{224}{A noise projection measurement was performed to determine if the excess noise in the photocurrent produced by the IG24x500S4i (see Figure~\ref {fig:pdchaptershotnoiseproblemig24}) was due to bias noise. The left hand panels show the Bode plot of the transfer function between the photodiode's cathode and the output of the transimpedance amplifier when the photodiode was producing 1.3\,mA of photocurrent. The right hand panel shows the effect of subtracting bias noise from the signal at the output of the transimpedance amplifier. The peak at 1121\,Hz was a modulation applied to the photodiode's cathode; 42.5\,dB of this signal was removed, which is in close agreement with the amount expected from the measured transfer function, by using the noise projection technique. However, the level of the broadband noise remained unchanged thus indicating that the excess noise witnessed in the photocurrent produced by the IG24x500S4i was not due to bias noise.\relax }{figure.caption.265}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.13}{\ignorespaces To investigate reasons why there was excess noise in the photocurrent produced by the IG24x500S4i, its ideality factor was measured (red points). Equation\nobreakspace  {}\ref  {eq:pd_chapter_ideality_factor} was used to do an unweighted fit to the data ($I_0 = (360\pm 10)\tmspace  +\thinmuskip {.1667em}\si {nA}$ and $n = 1.02\pm 0.01$). The random error in this measurement $\sim 1\tmspace  +\thinmuskip {.1667em}\si {\nano \ampere }$, however a systematic error due to contact potential affected the data below 0.02\tmspace  +\thinmuskip {.1667em}V . The IG24x500S4i was found to be close to ideal as $n$ was close to unity and so this does not provide clues to the source of excess noise in the photocurrent.\relax }}{225}{figure.caption.266}}
\newlabel{fig:pdchapterforwardbiasiv}{{8.13}{225}{To investigate reasons why there was excess noise in the photocurrent produced by the IG24x500S4i, its ideality factor was measured (red points). Equation~\ref {eq:pd_chapter_ideality_factor} was used to do an unweighted fit to the data ($I_0 = (360\pm 10)\,\si {nA}$ and $n = 1.02\pm 0.01$). The random error in this measurement $\sim 1\,\si {\nano \ampere }$, however a systematic error due to contact potential affected the data below 0.02\,V . The IG24x500S4i was found to be close to ideal as $n$ was close to unity and so this does not provide clues to the source of excess noise in the photocurrent.\relax }{figure.caption.266}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.14}{\ignorespaces Light was shone onto the photodiode and the current produced at 0.05\tmspace  +\thinmuskip {.1667em}V forward bias was recorded. These measurements are shown by the star shaped markers. Based on the model obtained from the data shown in Figure\nobreakspace  {}\ref  {fig:pdchapterforwardbiasiv}, the current flowing through the photodiode was predicted (shown by the lines). The model and the measurements agree with each other, although the photodiode may have been saturating for the 3.3\tmspace  +\thinmuskip {.1667em}mW measurement.\relax }}{226}{figure.caption.267}}
\newlabel{fig:pdchapterforwardbiasmodelwithlight}{{8.14}{226}{Light was shone onto the photodiode and the current produced at 0.05\,V forward bias was recorded. These measurements are shown by the star shaped markers. Based on the model obtained from the data shown in Figure~\ref {fig:pdchapterforwardbiasiv}, the current flowing through the photodiode was predicted (shown by the lines). The model and the measurements agree with each other, although the photodiode may have been saturating for the 3.3\,mW measurement.\relax }{figure.caption.267}{}}
