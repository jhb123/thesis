\@writefile{lof}{\contentsline {figure}{\numberline {B.5}{\ignorespaces The transfer function between a current into the inverting input of the transimpedance amplifiers designs shown in Figures \ref  {fig:circuitappendixdarknoisetestbox1}\ref  {fig:circuitappendixdarknoisetestbox2} and \ref  {fig:circuitappendixdarknoisetestbox3} was measured and simulated using \textsc  {Liso}. A \textsc  {Matlab} function (see Section \ref  {sec:appendix_TIA_TF}) was used to check the measurement and the simulation. This circuit is sensitive to stray capacitance (s.c.) at the inverting input of the TL071. The stray capacitance was reduced by changing the layout of the circuit.\relax }}{252}{figure.caption.292}}
\newlabel{fig:circuitappendixtransimpedanceamplifiertf}{{B.5}{252}{The transfer function between a current into the inverting input of the transimpedance amplifiers designs shown in Figures \ref {fig:circuitappendixdarknoisetestbox1}\ref {fig:circuitappendixdarknoisetestbox2} and \ref {fig:circuitappendixdarknoisetestbox3} was measured and simulated using \textsc {Liso}. A \textsc {Matlab} function (see Section \ref {sec:appendix_TIA_TF}) was used to check the measurement and the simulation. This circuit is sensitive to stray capacitance (s.c.) at the inverting input of the TL071. The stray capacitance was reduced by changing the layout of the circuit.\relax }{figure.caption.292}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.6}{\ignorespaces At low frequencies, the noise of the circuit design shown in Figures \ref  {fig:circuitappendixdarknoisetestbox1}\ref  {fig:circuitappendixdarknoisetestbox2} and \ref  {fig:circuitappendixdarknoisetestbox3} is dominated by the low frequency voltage noise of the TL071. Above 10\tmspace  +\thinmuskip {.1667em}Hz, the noise of the circuit is dominated by the johnson-Nyquist noise of the feedback resistor. At 30\tmspace  +\thinmuskip {.1667em}kHz, the impedance of the feedback network causes the TL071's voltage noise to rise above the resistors noise. \relax }}{253}{figure.caption.293}}
\newlabel{fig:circuitappendixdarknoiseboxnoise}{{B.6}{253}{At low frequencies, the noise of the circuit design shown in Figures \ref {fig:circuitappendixdarknoisetestbox1}\ref {fig:circuitappendixdarknoisetestbox2} and \ref {fig:circuitappendixdarknoisetestbox3} is dominated by the low frequency voltage noise of the TL071. Above 10\,Hz, the noise of the circuit is dominated by the johnson-Nyquist noise of the feedback resistor. At 30\,kHz, the impedance of the feedback network causes the TL071's voltage noise to rise above the resistors noise. \relax }{figure.caption.293}{}}
