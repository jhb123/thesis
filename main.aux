\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces Comparison between the phase of the light reflected from a mirror versus the phase of light reflected from a cavity as the position of the mirror/end mirror is changed. The orange line shows the extra round trip phase acquired by light in the arm if the ETM is moved one wavelength (360\si {\qopname  \relax o{deg}}) and the blue line shows the same thing except for an Fabry-Perot cavity. The phase of the light reflected from the cavity rapidly changes as it moves through the resonance. The interferometers sensitivity is proportional to the slope $\frac  {d \phi _{\rm  {EM}}}{d \phi _{\rm  {ETM}}}$, and so a Fabry-Perot cavity can increase the sensitivity of the interferometer.\relax }}{13}{figure.caption.13}}
\newlabel{fig:detectorchapterfabryvsmirror}{{1.2}{13}{Comparison between the phase of the light reflected from a mirror versus the phase of light reflected from a cavity as the position of the mirror/end mirror is changed. The orange line shows the extra round trip phase acquired by light in the arm if the ETM is moved one wavelength (360\si {\deg }) and the blue line shows the same thing except for an Fabry-Perot cavity. The phase of the light reflected from the cavity rapidly changes as it moves through the resonance. The interferometers sensitivity is proportional to the slope $\frac {d \phi _{\rm {EM}}}{d \phi _{\rm {ETM}}}$, and so a Fabry-Perot cavity can increase the sensitivity of the interferometer.\relax }{figure.caption.13}{}}
\newlabel{eq:phase_photon_number_relation}{{1.9}{14}{Laser Power and Shot Noise}{equation.1.4.9}{}}
\@writefile{toc}{\contentsline {paragraph}{}{14}{section*.14}}
\newlabel{eq:detector_chapter_AS_port_TF}{{1.11}{14}{}{equation.1.4.11}{}}
\newlabel{eq:detector_chapter_shot_noise_ifo}{{1.12}{14}{}{equation.1.4.12}{}}
\@writefile{toc}{\contentsline {paragraph}{}{14}{section*.15}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces The light blue and light red lines show the design sensitivity of the aLIGO and LIGO A+ detectors. The quantum noise, noise due to radiation pressure and photon shot noise, is shown in dark-blue (aLIGO) and dark-red (A+). Above 10\tmspace  +\thinmuskip {.1667em}Hz, quantum effects are one of the limiting sources of noise. Below 10\tmspace  +\thinmuskip {.1667em}Hz, classical noise sources, e.g.\nobreakspace  {}seismic motion, limit the sensitivity of the detector. Above 100\tmspace  +\thinmuskip {.1667em}Hz, shot noise limits the sensitivity of both detectors. Shot noise rises with $f$ due to the arm cavities. Below 100\tmspace  +\thinmuskip {.1667em}Hz, the quantum noise goes as $1/f$ due to radiation pressure. Coating thermal noise will limit the A+ detectors's sensitivity around $\sim 100\tmspace  +\thinmuskip {.1667em}\si {\hertz }$.\relax }}{15}{figure.caption.16}}
\newlabel{fig:detectorchapterdesignsensitivitycurves}{{1.3}{15}{The light blue and light red lines show the design sensitivity of the aLIGO and LIGO A+ detectors. The quantum noise, noise due to radiation pressure and photon shot noise, is shown in dark-blue (aLIGO) and dark-red (A+). Above 10\,Hz, quantum effects are one of the limiting sources of noise. Below 10\,Hz, classical noise sources, e.g.~seismic motion, limit the sensitivity of the detector. Above 100\,Hz, shot noise limits the sensitivity of both detectors. Shot noise rises with $f$ due to the arm cavities. Below 100\,Hz, the quantum noise goes as $1/f$ due to radiation pressure. Coating thermal noise will limit the A+ detectors's sensitivity around $\sim 100\,\si {\hertz }$.\relax }{figure.caption.16}{}}
