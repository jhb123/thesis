\@writefile{lof}{\contentsline {figure}{\numberline {2.18}{\ignorespaces Sketch of the amplitude stabilisation servo. The components highlighted in blue have been shown in more detail. By injecting a signal into `TF in' and measuring the ratio $b/a$, the transfer function of all the parts of the servo except for the unity summing stage, $H$, was measured. The measurement of the open loop transfer function with the variable gain stage set to 20\tmspace  +\thinmuskip {.1667em}dB is shown in Figure\nobreakspace  {}\ref  {fig:ligolaserchapteropenlooptransferfunction}. A block diagram of $H$ is shown in Figure\nobreakspace  {}\ref  {fig:ligolaserchapteroltfmodelblockdiagram}.\relax }}{69}{figure.caption.29}}
\newlabel{fig:ligolaserchapteroltfmeasurement}{{2.18}{69}{Sketch of the amplitude stabilisation servo. The components highlighted in blue have been shown in more detail. By injecting a signal into `TF in' and measuring the ratio $b/a$, the transfer function of all the parts of the servo except for the unity summing stage, $H$, was measured. The measurement of the open loop transfer function with the variable gain stage set to 20\,dB is shown in Figure~\ref {fig:ligolaserchapteropenlooptransferfunction}. A block diagram of $H$ is shown in Figure~\ref {fig:ligolaserchapteroltfmodelblockdiagram}.\relax }{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.19}{\ignorespaces The open-loop transfer function was measured using the layout shown in Figure\nobreakspace  {}\ref  {fig:ligolaserchapteroltfmeasurement}. The unity gain point is at 48\tmspace  +\thinmuskip {.1667em}\si {\kilo \hertz } with 70\si {\degree } of phase margin. The shaping of the servo is $1/f$ at the unity gain point, but to achieve higher gain at low frequency, the servo has a $1/f^3$ slope between 10\tmspace  +\thinmuskip {.1667em}Hz---5\tmspace  +\thinmuskip {.1667em}kHz. The measurement saturated below 100\tmspace  +\thinmuskip {.1667em}Hz. The model and measurement do not agree well below a few kHz due to the measurement saturating.\relax }}{70}{figure.caption.30}}
\newlabel{fig:ligolaserchapteropenlooptransferfunction}{{2.19}{70}{The open-loop transfer function was measured using the layout shown in Figure~\ref {fig:ligolaserchapteroltfmeasurement}. The unity gain point is at 48\,\si {\kilo \hertz } with 70\si {\degree } of phase margin. The shaping of the servo is $1/f$ at the unity gain point, but to achieve higher gain at low frequency, the servo has a $1/f^3$ slope between 10\,Hz---5\,kHz. The measurement saturated below 100\,Hz. The model and measurement do not agree well below a few kHz due to the measurement saturating.\relax }{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.20}{\ignorespaces A block diagram of the components in the intensity stabilisation servo. The transfer function of each block is described in Section\nobreakspace  {}\ref  {sec:ligolaserchapterservomodel} and Table\nobreakspace  {}\ref  {tab:ligolaserchapterservomodel}. Additional integrators can be activated with a digital switch. The overall gain of the servo depends on a variable gain \gls {ic} and the amount of light on the photodiode. The shaping of each block is indicated below it.\relax }}{71}{figure.caption.31}}
\newlabel{fig:ligolaserchapteroltfmodelblockdiagram}{{2.20}{71}{A block diagram of the components in the intensity stabilisation servo. The transfer function of each block is described in Section~\ref {sec:ligolaserchapterservomodel} and Table~\ref {tab:ligolaserchapterservomodel}. Additional integrators can be activated with a digital switch. The overall gain of the servo depends on a variable gain \gls {ic} and the amount of light on the photodiode. The shaping of each block is indicated below it.\relax }{figure.caption.31}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.5.4.1}Model of the Open-Loop Transfer Function}{71}{subsubsection.2.5.4.1}}
\newlabel{sec:ligolaserchapterservomodel}{{2.5.4.1}{71}{Model of the Open-Loop Transfer Function}{figure.caption.31}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2.1}{\ignorespaces Model of the intensity stabilisation servo expressed in terms of the complex angular frequency, $s = \omega + i\sigma $. Base ten exponention is represent with `$\rm  {e}$'. Note that in reality the gain is distributed amongst each block; for clarity, in this model all the components have unity gain at DC and the overall DC gain factor is given. The additional integrators have been expressed as a separate block to the transitional integrators with a pole that cancels a zero in the transitional integrators; in the transfer function of this additional integrator, the zero was chosen to be below any frequency of interest and does not exist in the servo. It was included here to make modelling the servo more clear. \relax }}{72}{table.caption.32}}
\newlabel{tab:ligolaserchapterservomodel}{{2.1}{72}{Model of the intensity stabilisation servo expressed in terms of the complex angular frequency, $s = \omega + i\sigma $. Base ten exponention is represent with `$\rm {e}$'. Note that in reality the gain is distributed amongst each block; for clarity, in this model all the components have unity gain at DC and the overall DC gain factor is given. The additional integrators have been expressed as a separate block to the transitional integrators with a pole that cancels a zero in the transitional integrators; in the transfer function of this additional integrator, the zero was chosen to be below any frequency of interest and does not exist in the servo. It was included here to make modelling the servo more clear. \relax }{table.caption.32}{}}
