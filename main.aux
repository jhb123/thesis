\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces The sensitivity curve for the A+ detectors expressed in units of $\si {\radian _{\rm  {rms}}/\sqrt  {Hz}}$. At frequencies above 1\tmspace  +\thinmuskip {.1667em}kHz, the noise is flat ($3.4\times 10^{-5}\tmspace  +\thinmuskip {.1667em}\si {\radian _{\rm  {rms}}/\sqrt  {\hertz }}$) as it is dominated by shot noise. At lower frequencies, the noise is increased relative to shot noise due to radiation pressure, coating thermal noise and other noise sources. At 5\tmspace  +\thinmuskip {.1667em}\si {\hertz }, the noise is $8\times 10^{-5}\tmspace  +\thinmuskip {.1667em}\si {\radian _{\rm  {rms}}/\sqrt  {\hertz }}$.\relax }}{146}{figure.caption.61}}
\newlabel{fig:bhdforligochapterphasenoise}{{5.4}{146}{The sensitivity curve for the A+ detectors expressed in units of $\si {\radian _{\rm {rms}}/\sqrt {Hz}}$. At frequencies above 1\,kHz, the noise is flat ($3.4\times 10^{-5}\,\si {\radian _{\rm {rms}}/\sqrt {\hertz }}$) as it is dominated by shot noise. At lower frequencies, the noise is increased relative to shot noise due to radiation pressure, coating thermal noise and other noise sources. At 5\,\si {\hertz }, the noise is $8\times 10^{-5}\,\si {\radian _{\rm {rms}}/\sqrt {\hertz }}$.\relax }{figure.caption.61}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces The sensitivity curve for A+ sets the limit on the amount of path length noise that is acceptable between the AS and LO beams. The blue line shows sensitivity curve in units of path length noise between the AS and LO beams, and the orange line shows the longitudinal motion requirement for the optics which combine the LO and signal beam. At 5\tmspace  +\thinmuskip {.1667em}Hz, the longitudinal motion requirement for the optics is $4.9\times 10^{-13}\tmspace  +\thinmuskip {.1667em}\si {\metre _{\rm  {rms}}/\sqrt  {\hertz }}$.\relax }}{147}{figure.caption.62}}
\newlabel{fig:bhdforligochapterhrtsrequirement}{{5.5}{147}{The sensitivity curve for A+ sets the limit on the amount of path length noise that is acceptable between the AS and LO beams. The blue line shows sensitivity curve in units of path length noise between the AS and LO beams, and the orange line shows the longitudinal motion requirement for the optics which combine the LO and signal beam. At 5\,Hz, the longitudinal motion requirement for the optics is $4.9\times 10^{-13}\,\si {\metre _{\rm {rms}}/\sqrt {\hertz }}$.\relax }{figure.caption.62}{}}
