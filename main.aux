\@writefile{lof}{\contentsline {figure}{\numberline {8.9}{\ignorespaces Sketch of the in-vacuum Mach-Zehnder. Laser light entered the vacuum system and was steered by suspended optics into a Mach-Zehnder interferometer. The first beam splitter and the two corner mirrors were in identical suspensions. The suspensions are described in Section\nobreakspace  {}\ref  {sec:mz_chapter_in_vac_susp}. The beam splitter for recombining the beam was part of a larger suspended assembly which also included steering mirrors and the photodiodes. Photographs of the components are shown in Figure\nobreakspace  {}\ref  {fig:mzchapterinvacuummzapparatus}. The mirrors and the beam splitter were suspended with identical suspensions, and the recombining beam splitter was part of a larger assembly.\relax }}{231}{figure.caption.98}}
\newlabel{fig:mzchapterinvacuumsketch}{{8.9}{231}{Sketch of the in-vacuum Mach-Zehnder. Laser light entered the vacuum system and was steered by suspended optics into a Mach-Zehnder interferometer. The first beam splitter and the two corner mirrors were in identical suspensions. The suspensions are described in Section~\ref {sec:mz_chapter_in_vac_susp}. The beam splitter for recombining the beam was part of a larger suspended assembly which also included steering mirrors and the photodiodes. Photographs of the components are shown in Figure~\ref {fig:mzchapterinvacuummzapparatus}. The mirrors and the beam splitter were suspended with identical suspensions, and the recombining beam splitter was part of a larger assembly.\relax }{figure.caption.98}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.10}{\ignorespaces Photographs of the components used for the in-vacuum Mach-Zehnder. The scattered light originated from the uncoated back faces of the curved steering mirrors on the balanced homodyne detector platform. The design of the suspended mirrors is discussed in\nobreakspace  {}\cite  [Chapter\nobreakspace  {}5]{Jans_thesis}. The photograph was used by courtesy of Jan-Simon Hennig.\relax }}{232}{figure.caption.99}}
\newlabel{fig:mzchapterinvacuummzapparatus}{{8.10}{232}{Photographs of the components used for the in-vacuum Mach-Zehnder. The scattered light originated from the uncoated back faces of the curved steering mirrors on the balanced homodyne detector platform. The design of the suspended mirrors is discussed in~\cite [Chapter~5]{Jans_thesis}. The photograph was used by courtesy of Jan-Simon Hennig.\relax }{figure.caption.99}{}}
