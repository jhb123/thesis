\@writefile{lof}{\contentsline {figure}{\numberline {D.1}{\ignorespaces Optimisation of the parameters used in the \texttt  {gauss} command to mode match the laser to the arms in the simulations described in Chapter\nobreakspace  {}\ref  {chapter:simulation_finesse} and Section\nobreakspace  {}\ref  {sec:finesse_code}. The blue, green and orange lines show how the mode matching changes as the beam waist location is changed. As the mode mismatch became larger, more HOM were required; this is why the blue and green/orange lines diverge. A quadratic was fitted to the data highlighted in red, and the minimum value was used as the waist location parameter for the \texttt  {gauss} command.\relax }}{282}{figure.caption.131}}
\newlabel{fig:gausscommandfitting}{{D.1}{282}{Optimisation of the parameters used in the \texttt {gauss} command to mode match the laser to the arms in the simulations described in Chapter~\ref {chapter:simulation_finesse} and Section~\ref {sec:finesse_code}. The blue, green and orange lines show how the mode matching changes as the beam waist location is changed. As the mode mismatch became larger, more HOM were required; this is why the blue and green/orange lines diverge. A quadratic was fitted to the data highlighted in red, and the minimum value was used as the waist location parameter for the \texttt {gauss} command.\relax }{figure.caption.131}{}}
