\@writefile{toc}{\contentsline {subsection}{\numberline {3.4.1}The Effect of Cooling on the Amplifier's Power and Beam Quality}{20}{subsection.3.4.1}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces The top panel shows the power that was incident on the PMC and the power transmitted by the PMC over a 55 hour run. The light produced by the amplifiers did not not change significantly for the duration of this measurement, however the transmitted light through the PMC dropped from 111\tmspace  +\thinmuskip {.1667em}\si {\watt } to, at its lowest, 107\tmspace  +\thinmuskip {.1667em}\si {\watt }. This is likely due to the environmental conditions in the lab changing. The bottom panel shows the humidity of the lab. Changes in the humidity, which can be caused by a temperature change, coincides with changes in the power level of the amplifier.\relax }}{21}{figure.caption.22}}
\newlabel{fig:ligolaserchapterpowerplot}{{3.7}{21}{The top panel shows the power that was incident on the PMC and the power transmitted by the PMC over a 55 hour run. The light produced by the amplifiers did not not change significantly for the duration of this measurement, however the transmitted light through the PMC dropped from 111\,\si {\watt } to, at its lowest, 107\,\si {\watt }. This is likely due to the environmental conditions in the lab changing. The bottom panel shows the humidity of the lab. Changes in the humidity, which can be caused by a temperature change, coincides with changes in the power level of the amplifier.\relax }{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.8}{\ignorespaces Cartoon of the cooling layout for the PSL. The amplifiers are on a separate loop to the diode boxes so that the flow rates for these can be reduced as much as possible. By placing the flow rate sensors on the return side of the the cooling system, leaks can be detected.\relax }}{22}{figure.caption.24}}
\newlabel{fig:ligolaserchapterwatercoolingschematic}{{3.8}{22}{Cartoon of the cooling layout for the PSL. The amplifiers are on a separate loop to the diode boxes so that the flow rates for these can be reduced as much as possible. By placing the flow rate sensors on the return side of the the cooling system, leaks can be detected.\relax }{figure.caption.24}{}}
