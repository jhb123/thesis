\@writefile{toc}{\contentsline {section}{\numberline {B.1}A Transimpedance Amplifier for Measuring the Dark Noise of Photodiodes}{256}{section.B.1}}
\newlabel{sec:appendix_dark_noise_tia}{{B.1}{256}{A Transimpedance Amplifier for Measuring the Dark Noise of Photodiodes}{section.B.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.1}{\ignorespaces The circuit used to measure the dark noise of photodiodes, represented by \textsc  {Test\_PD}, under different reverse biases. The transimpedance amplifier has a 1\si {\mega \ohm } resistor (R2) in parallel with a 2.2\si {\pico \farad } capacitor (C2) in the feedback path of the TL071 op\nobreakspace  {}amp. The reverse bias was generated by a potentiometer (R1) connected to an LM7815 voltage regulator. This voltage was low passed using C1. Note that the low pass corner frequency depends on the setting of R1.\relax }}{257}{figure.caption.121}}
\newlabel{fig:circuitappendixdarknoisetestbox1}{{B.1}{257}{The circuit used to measure the dark noise of photodiodes, represented by \textsc {Test\_PD}, under different reverse biases. The transimpedance amplifier has a 1\si {\mega \ohm } resistor (R2) in parallel with a 2.2\si {\pico \farad } capacitor (C2) in the feedback path of the TL071 op~amp. The reverse bias was generated by a potentiometer (R1) connected to an LM7815 voltage regulator. This voltage was low passed using C1. Note that the low pass corner frequency depends on the setting of R1.\relax }{figure.caption.121}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.2}{\ignorespaces The circuit used to measure the dark noise of photodiodes. The transimpedance amplifier used is identical to the one shown in Figure\nobreakspace  {}\ref  {fig:circuitappendixdarknoisetestbox1}. The reverse bias voltage was controlled with the potentiometer \textsc  {BIAS\_ADJ}, and the reverse bias voltage was generated using an OP27 op\nobreakspace  {}amp (OP27D) with a gain less than one.\relax }}{258}{figure.caption.122}}
\newlabel{fig:circuitappendixdarknoisetestbox3}{{B.2}{258}{The circuit used to measure the dark noise of photodiodes. The transimpedance amplifier used is identical to the one shown in Figure~\ref {fig:circuitappendixdarknoisetestbox1}. The reverse bias voltage was controlled with the potentiometer \textsc {BIAS\_ADJ}, and the reverse bias voltage was generated using an OP27 op~amp (OP27D) with a gain less than one.\relax }{figure.caption.122}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.3}{\ignorespaces The circuit used to check that reverse bias voltage noise was not contaminating dark noise measurements. To reach $5\si {\nano \volt /\sqrt  {\hertz }}$ at 10\tmspace  +\thinmuskip {.1667em}Hz, a 10V low noise reference \gls {ic} (AD587JNZ) was used to generate the reverse bias. The output of this \gls {ic} was filtered by two low pass filters. The transimpedance amplifier used is identical to the one shown in Figure\nobreakspace  {}\ref  {fig:circuitappendixdarknoisetestbox1}\relax }}{259}{figure.caption.123}}
\newlabel{fig:circuitappendixdarknoisetestbox2}{{B.3}{259}{The circuit used to check that reverse bias voltage noise was not contaminating dark noise measurements. To reach $5\si {\nano \volt /\sqrt {\hertz }}$ at 10\,Hz, a 10V low noise reference \gls {ic} (AD587JNZ) was used to generate the reverse bias. The output of this \gls {ic} was filtered by two low pass filters. The transimpedance amplifier used is identical to the one shown in Figure~\ref {fig:circuitappendixdarknoisetestbox1}\relax }{figure.caption.123}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.4}{\ignorespaces The FD10D was biased with 1\tmspace  +\thinmuskip {.1667em}V in the circuits shown in Figure\nobreakspace  {}\ref  {fig:circuitappendixdarknoisetestbox1} and Figure\nobreakspace  {}\ref  {fig:circuitappendixdarknoisetestbox2}. The low-noise fixed-bias circuit and the circuit with a settable-bias gave the same results, so we can be confident that the circuits shown in Figures \ref  {fig:circuitappendixdarknoisetestbox1} and \ref  {fig:circuitappendixdarknoisetestbox2} will produce measurements that are not contaminated by reverse bias noise or noise due to how the photodiode is connected to the circuit.\relax }}{260}{figure.caption.124}}
\newlabel{fig:pdchapterbiascrosscheck}{{B.4}{260}{The FD10D was biased with 1\,V in the circuits shown in Figure~\ref {fig:circuitappendixdarknoisetestbox1} and Figure~\ref {fig:circuitappendixdarknoisetestbox2}. The low-noise fixed-bias circuit and the circuit with a settable-bias gave the same results, so we can be confident that the circuits shown in Figures \ref {fig:circuitappendixdarknoisetestbox1} and \ref {fig:circuitappendixdarknoisetestbox2} will produce measurements that are not contaminated by reverse bias noise or noise due to how the photodiode is connected to the circuit.\relax }{figure.caption.124}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {B.1.1}Transfer Function}{261}{subsection.B.1.1}}
\@writefile{toc}{\contentsline {subsection}{\numberline {B.1.2}Noise Measurement}{261}{subsection.B.1.2}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.5}{\ignorespaces The transfer function between a current into the inverting input of the transimpedance amplifier design shown in Figure\nobreakspace  {}\ref  {fig:circuitappendixdarknoisetestbox1}, Figure\nobreakspace  {}\ref  {fig:circuitappendixdarknoisetestbox3} and Figure\nobreakspace  {}\ref  {fig:circuitappendixdarknoisetestbox2} was measured and simulated using \textsc  {Liso}. A \textsc  {Matlab} function (see Section\nobreakspace  {}\ref  {sec:appendix_TIA_TF}) was used to check the measurement and the simulation. This circuit is sensitive to stray capacitance (s.c.) at the inverting input of the TL071. The stray capacitance was reduced by changing the physical layout of the circuit.\relax }}{262}{figure.caption.125}}
\newlabel{fig:circuitappendixtransimpedanceamplifiertf}{{B.5}{262}{The transfer function between a current into the inverting input of the transimpedance amplifier design shown in Figure~\ref {fig:circuitappendixdarknoisetestbox1}, Figure~\ref {fig:circuitappendixdarknoisetestbox3} and Figure~\ref {fig:circuitappendixdarknoisetestbox2} was measured and simulated using \textsc {Liso}. A \textsc {Matlab} function (see Section~\ref {sec:appendix_TIA_TF}) was used to check the measurement and the simulation. This circuit is sensitive to stray capacitance (s.c.) at the inverting input of the TL071. The stray capacitance was reduced by changing the physical layout of the circuit.\relax }{figure.caption.125}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.6}{\ignorespaces At low frequencies, the noise of the transimpedance amplifier shown in Figure\nobreakspace  {}\ref  {fig:circuitappendixdarknoisetestbox1}, Figure\nobreakspace  {}\ref  {fig:circuitappendixdarknoisetestbox3} and Figure\nobreakspace  {}\ref  {fig:circuitappendixdarknoisetestbox2} is dominated by the low frequency voltage noise of the TL071. Above 10\tmspace  +\thinmuskip {.1667em}Hz, the noise of the circuit is dominated by the Johnson-Nyquist noise of the feedback resistor. At 30\tmspace  +\thinmuskip {.1667em}kHz, the impedance of the feedback network causes a noise peak. \relax }}{263}{figure.caption.126}}
\newlabel{fig:circuitappendixdarknoiseboxnoise}{{B.6}{263}{At low frequencies, the noise of the transimpedance amplifier shown in Figure~\ref {fig:circuitappendixdarknoisetestbox1}, Figure~\ref {fig:circuitappendixdarknoisetestbox3} and Figure~\ref {fig:circuitappendixdarknoisetestbox2} is dominated by the low frequency voltage noise of the TL071. Above 10\,Hz, the noise of the circuit is dominated by the Johnson-Nyquist noise of the feedback resistor. At 30\,kHz, the impedance of the feedback network causes a noise peak. \relax }{figure.caption.126}{}}
