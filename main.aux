\newlabel{sec:appendix_dark_noise_tia}{{B.1}{40}{Transimpedance Amplifier for Measuring the Dark Noise of Photodiodes}{section.B.1}{}}
\@writefile{toc}{\contentsline {paragraph}{}{40}{section*.66}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.1}{\ignorespaces Circuit used to measure the dark noise of photodiodes, represented by \textsc  {Test\_PD}, under different reverse biases. The transimpedance amplifier has a 1\si {\mega \ohm } (R2) in parallel with a 2.2\si {\pico \farad } capacitor (C2) in the feedback path of the TL071 op amp (TL071P). The reverse bias was generated by a potentiometer (R1) connected to an LM7815 voltage regulator. This voltage was low passed using C1\relax }}{41}{figure.caption.68}}
\newlabel{fig:circuitappendixdarknoisetestbox1}{{B.1}{41}{Circuit used to measure the dark noise of photodiodes, represented by \textsc {Test\_PD}, under different reverse biases. The transimpedance amplifier has a 1\si {\mega \ohm } (R2) in parallel with a 2.2\si {\pico \farad } capacitor (C2) in the feedback path of the TL071 op amp (TL071P). The reverse bias was generated by a potentiometer (R1) connected to an LM7815 voltage regulator. This voltage was low passed using C1\relax }{figure.caption.68}{}}
\@writefile{toc}{\contentsline {paragraph}{}{41}{section*.67}}
\@writefile{toc}{\contentsline {paragraph}{}{41}{section*.70}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.2}{\ignorespaces Circuit used to measure the dark noise of photodiodes. The transimpedance amplifier used is identical to the one shown in Figure \ref  {fig:circuitappendixdarknoisetestbox1} .The bias voltage was generated using an OP27 op amp (OP27D) configured with so that the gain between the inverting input and the output of OP27D was $>1$.\relax }}{42}{figure.caption.69}}
\newlabel{fig:circuitappendixdarknoisetestbox3}{{B.2}{42}{Circuit used to measure the dark noise of photodiodes. The transimpedance amplifier used is identical to the one shown in Figure \ref {fig:circuitappendixdarknoisetestbox1} .The bias voltage was generated using an OP27 op amp (OP27D) configured with so that the gain between the inverting input and the output of OP27D was $>1$.\relax }{figure.caption.69}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.3}{\ignorespaces Circuit used to check that bias voltage noise was not contaminating dark noise measurements. To reach $5\si {\nano \volt /\sqrt  {\hertz }}$ at 10\tmspace  +\thinmuskip {.1667em}Hz, a 10V low noise reference IC (AD587JNZ) was used to generate the reverse bias. The output of this IC was filtered by two low pass filters (IC1A and IC2A). The transimpedance amplifier used is identical to the one shown in Figure \ref  {fig:circuitappendixdarknoisetestbox1}\relax }}{43}{figure.caption.71}}
\newlabel{fig:circuitappendixdarknoisetestbox2}{{B.3}{43}{Circuit used to check that bias voltage noise was not contaminating dark noise measurements. To reach $5\si {\nano \volt /\sqrt {\hertz }}$ at 10\,Hz, a 10V low noise reference IC (AD587JNZ) was used to generate the reverse bias. The output of this IC was filtered by two low pass filters (IC1A and IC2A). The transimpedance amplifier used is identical to the one shown in Figure \ref {fig:circuitappendixdarknoisetestbox1}\relax }{figure.caption.71}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {B.1.1}Transfer function}{43}{subsection.B.1.1}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.4}{\ignorespaces The FD10D was biased with 1\tmspace  +\thinmuskip {.1667em}V in the circuits shown in Figure \ref  {fig:circuitappendixdarknoisetestbox1} and Figure \ref  {fig:circuitappendixdarknoisetestbox3}. The low noise fixed bias circuit and the circuit with a settable bias gave the same results, so we can be confident that the circuits shown in Figures \ref  {fig:circuitappendixdarknoisetestbox1} and \ref  {fig:circuitappendixdarknoisetestbox2} will produce measurements that are not contaminated by bias noise.\relax }}{44}{figure.caption.72}}
\newlabel{fig:pdchapterbiascrosscheck}{{B.4}{44}{The FD10D was biased with 1\,V in the circuits shown in Figure \ref {fig:circuitappendixdarknoisetestbox1} and Figure \ref {fig:circuitappendixdarknoisetestbox3}. The low noise fixed bias circuit and the circuit with a settable bias gave the same results, so we can be confident that the circuits shown in Figures \ref {fig:circuitappendixdarknoisetestbox1} and \ref {fig:circuitappendixdarknoisetestbox2} will produce measurements that are not contaminated by bias noise.\relax }{figure.caption.72}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {B.1.2}Noise measurement}{45}{subsection.B.1.2}}
\@writefile{toc}{\contentsline {section}{\numberline {B.2}Transimpedance Amplifier for Making Shot Noise limited Measurements of 10\tmspace  +\thinmuskip {.1667em}mA Photocurrents}{45}{section.B.2}}
\newlabel{sec:circuits_appendix_variable_bias_ad797}{{B.2}{45}{Transimpedance Amplifier for Making Shot Noise limited Measurements of 10\,mA Photocurrents}{section.B.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.5}{\ignorespaces The transfer function between a current into the inverting input of the transimpedance amplifiers designs shown in Figures \ref  {fig:circuitappendixdarknoisetestbox1}\ref  {fig:circuitappendixdarknoisetestbox2} and \ref  {fig:circuitappendixdarknoisetestbox3} was measured and simulated using \textsc  {Liso}. A \textsc  {Matlab} function (see Section \ref  {sec:appendix_TIA_TF}) was used to check the measurement and the simulation. This circuit is sensitive to stray capacitance (s.c.) at the inverting input of the TL071. The stray capacitance was reduced by changing the layout of the circuit.\relax }}{46}{figure.caption.73}}
\newlabel{fig:circuitappendixtransimpedanceamplifiertf}{{B.5}{46}{The transfer function between a current into the inverting input of the transimpedance amplifiers designs shown in Figures \ref {fig:circuitappendixdarknoisetestbox1}\ref {fig:circuitappendixdarknoisetestbox2} and \ref {fig:circuitappendixdarknoisetestbox3} was measured and simulated using \textsc {Liso}. A \textsc {Matlab} function (see Section \ref {sec:appendix_TIA_TF}) was used to check the measurement and the simulation. This circuit is sensitive to stray capacitance (s.c.) at the inverting input of the TL071. The stray capacitance was reduced by changing the layout of the circuit.\relax }{figure.caption.73}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.6}{\ignorespaces At low frequencies, the noise of the circuit design shown in Figures \ref  {fig:circuitappendixdarknoisetestbox1}\ref  {fig:circuitappendixdarknoisetestbox2} and \ref  {fig:circuitappendixdarknoisetestbox3} is dominated by the low frequency voltage noise of the TL071. Above 10\tmspace  +\thinmuskip {.1667em}Hz, the noise of the circuit is dominated by the johnson-Nyquist noise of the feedback resistor. At 30\tmspace  +\thinmuskip {.1667em}kHz, the impedance of the feedback network causes the TL071's voltage noise to rise above the resistors noise. \relax }}{47}{figure.caption.74}}
\newlabel{fig:circuitappendixdarknoiseboxnoise}{{B.6}{47}{At low frequencies, the noise of the circuit design shown in Figures \ref {fig:circuitappendixdarknoisetestbox1}\ref {fig:circuitappendixdarknoisetestbox2} and \ref {fig:circuitappendixdarknoisetestbox3} is dominated by the low frequency voltage noise of the TL071. Above 10\,Hz, the noise of the circuit is dominated by the johnson-Nyquist noise of the feedback resistor. At 30\,kHz, the impedance of the feedback network causes the TL071's voltage noise to rise above the resistors noise. \relax }{figure.caption.74}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.7}{\ignorespaces \relax }}{47}{figure.caption.75}}
\newlabel{fig:pdchapterqetestcircuit}{{B.7}{47}{\relax }{figure.caption.75}{}}
