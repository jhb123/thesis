\contentsline {chapter}{\numberline {A}Algorithm For Finding a Three Optic Solution with 45\si {\degree } Gouy Phase Separation between two of the Optics}{31}{appendix.A}
\contentsline {paragraph}{}{32}{section*.40}
\contentsline {paragraph}{}{32}{section*.41}
\contentsline {subsection}{\numberline {A.0.1}Method}{32}{subsection.A.0.1}
\contentsline {paragraph}{Define the target mode at the optic 3.}{33}{section*.42}
\contentsline {paragraph}{Define a set of modes which share the same beam size as the target mode at optic 3 but have varying radii of curvature.}{33}{section*.43}
\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{33}{section*.44}
\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{33}{section*.45}
\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{33}{section*.46}
\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{33}{section*.47}
\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{33}{section*.48}
\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{33}{section*.49}
\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{34}{section*.50}
\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{34}{section*.51}
\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{34}{section*.52}
\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{34}{section*.53}
\contentsline {paragraph}{}{34}{section*.54}
