\contentsline {chapter}{\numberline {B}Algorithm For Finding a Three Optic Solution with 45\si {\degree } Gouy Phase Separation between two of the Optics}{103}{appendix.B}
\contentsline {paragraph}{}{104}{section*.129}
\contentsline {paragraph}{}{104}{section*.130}
\contentsline {subsection}{\numberline {B.0.1}Method}{104}{subsection.B.0.1}
\contentsline {paragraph}{Define the target mode at the optic 3.}{105}{section*.131}
\contentsline {paragraph}{Define a set of modes which share the same beam size as the target mode at optic 3 but have varying radii of curvature.}{105}{section*.132}
\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{105}{section*.133}
\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{105}{section*.134}
\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{105}{section*.135}
\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{105}{section*.136}
\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{105}{section*.137}
\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{105}{section*.138}
\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{106}{section*.139}
\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{106}{section*.140}
\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{106}{section*.141}
\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{106}{section*.142}
\contentsline {paragraph}{}{106}{section*.143}
