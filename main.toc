\contentsline {chapter}{\numberline {B}Algorithm For Finding a Three Optic Solution with 45\si {\degree } Gouy Phase Separation between two of the Optics}{152}{appendix.B}
\contentsline {paragraph}{}{153}{section*.166}
\contentsline {paragraph}{}{153}{section*.167}
\contentsline {subsection}{\numberline {B.0.1}Method}{153}{subsection.B.0.1}
\contentsline {paragraph}{Define the target mode at the optic 3.}{154}{section*.168}
\contentsline {paragraph}{Define a set of modes which share the same beam size as the target mode at optic 3 but have varying radii of curvature.}{154}{section*.169}
\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{154}{section*.170}
\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{154}{section*.171}
\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{154}{section*.172}
\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{154}{section*.173}
\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{154}{section*.174}
\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{154}{section*.175}
\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{155}{section*.176}
\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{155}{section*.177}
\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{155}{section*.178}
\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{155}{section*.179}
\contentsline {paragraph}{}{155}{section*.180}
