\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{274}{section*.356}
\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{274}{section*.357}
\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{274}{section*.358}
\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{274}{section*.359}
\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{274}{section*.360}
\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{274}{section*.361}
\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{275}{section*.362}
\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{275}{section*.363}
\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{275}{section*.364}
\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{275}{section*.365}
\contentsline {paragraph}{}{275}{section*.366}
