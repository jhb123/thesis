\contentsline {chapter}{\numberline {E}Algorithm For Finding a Three Optic Solution with 45\si {\degree } Gouy Phase Separation between two of the Optics}{292}{appendix.E}
\contentsline {subsection}{\numberline {E.0.1}Method}{294}{subsection.E.0.1}
\contentsline {paragraph}{Define the target mode at the optic 3.}{294}{section*.140}
\contentsline {paragraph}{Define a set of modes which share the same beam size as the target mode at optic 3 but have varying radii of curvature.}{294}{section*.141}
\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{294}{section*.142}
\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{294}{section*.143}
\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{294}{section*.144}
\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{295}{section*.145}
\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{295}{section*.146}
\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{295}{section*.147}
\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{295}{section*.148}
\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{295}{section*.149}
\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{295}{section*.150}
\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{295}{section*.151}
