\contentsline {paragraph}{}{277}{section*.360}
\contentsline {subsection}{\numberline {D.0.1}Method}{277}{subsection.D.0.1}
\contentsline {paragraph}{Define the target mode at the optic 3.}{278}{section*.361}
\contentsline {paragraph}{Define a set of modes which share the same beam size as the target mode at optic 3 but have varying radii of curvature.}{278}{section*.362}
\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{278}{section*.363}
\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{278}{section*.364}
\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{278}{section*.365}
\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{278}{section*.366}
\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{278}{section*.367}
\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{278}{section*.368}
\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{279}{section*.369}
\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{279}{section*.370}
\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{279}{section*.371}
\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{279}{section*.372}
\contentsline {paragraph}{}{279}{section*.373}
