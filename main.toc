\contentsline {chapter}{\numberline {B}Algorithm For Finding a Three Optic Solution with 45\si {\degree } Gouy Phase Separation between two of the Optics}{70}{appendix.B}
\contentsline {paragraph}{}{71}{section*.92}
\contentsline {paragraph}{}{71}{section*.93}
\contentsline {subsection}{\numberline {B.0.1}Method}{71}{subsection.B.0.1}
\contentsline {paragraph}{Define the target mode at the optic 3.}{72}{section*.94}
\contentsline {paragraph}{Define a set of modes which share the same beam size as the target mode at optic 3 but have varying radii of curvature.}{72}{section*.95}
\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{72}{section*.96}
\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{72}{section*.97}
\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{72}{section*.98}
\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{72}{section*.99}
\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{72}{section*.100}
\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{72}{section*.101}
\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{73}{section*.102}
\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{73}{section*.103}
\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{73}{section*.104}
\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{73}{section*.105}
\contentsline {paragraph}{}{73}{section*.106}
