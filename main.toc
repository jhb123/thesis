\contentsline {chapter}{\numberline {C}\textsc {Finesse} Simulations}{124}{appendix.C}
\contentsline {chapter}{\numberline {D}Algorithm For Finding a Three Optic Solution with 45\si {\degree } Gouy Phase Separation between two of the Optics}{125}{appendix.D}
\contentsline {paragraph}{}{126}{section*.168}
\contentsline {paragraph}{}{126}{section*.169}
\contentsline {subsection}{\numberline {D.0.1}Method}{126}{subsection.D.0.1}
\contentsline {paragraph}{Define the target mode at the optic 3.}{127}{section*.170}
\contentsline {paragraph}{Define a set of modes which share the same beam size as the target mode at optic 3 but have varying radii of curvature.}{127}{section*.171}
\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{127}{section*.172}
\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{127}{section*.173}
\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{127}{section*.174}
\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{127}{section*.175}
\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{127}{section*.176}
\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{127}{section*.177}
\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{128}{section*.178}
\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{128}{section*.179}
\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{128}{section*.180}
\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{128}{section*.181}
\contentsline {paragraph}{}{128}{section*.182}
