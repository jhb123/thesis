\contentsline {chapter}{\numberline {B}Algorithm For Finding a Three Optic Solution with 45\si {\degree } Gouy Phase Separation between two of the Optics}{146}{appendix.B}
\contentsline {paragraph}{}{147}{section*.182}
\contentsline {paragraph}{}{147}{section*.183}
\contentsline {subsection}{\numberline {B.0.1}Method}{147}{subsection.B.0.1}
\contentsline {paragraph}{Define the target mode at the optic 3.}{148}{section*.184}
\contentsline {paragraph}{Define a set of modes which share the same beam size as the target mode at optic 3 but have varying radii of curvature.}{148}{section*.185}
\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{148}{section*.186}
\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{148}{section*.187}
\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{148}{section*.188}
\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{148}{section*.189}
\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{148}{section*.190}
\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{148}{section*.191}
\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{149}{section*.192}
\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{149}{section*.193}
\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{149}{section*.194}
\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{149}{section*.195}
\contentsline {paragraph}{}{149}{section*.196}
