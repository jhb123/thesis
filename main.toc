\contentsline {chapter}{\numberline {D}Algorithm For Finding a Three Optic Solution with 45\si {\degree } Gouy Phase Separation between two of the Optics}{295}{appendix.D}
\contentsline {subsection}{\numberline {D.0.1}Method}{297}{subsection.D.0.1}
\contentsline {paragraph}{Define the target mode at the optic 3.}{297}{section*.139}
\contentsline {paragraph}{Define a set of modes which share the same beam size as the target mode at optic 3 but have varying radii of curvature.}{297}{section*.140}
\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{297}{section*.141}
\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{297}{section*.142}
\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{297}{section*.143}
\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{298}{section*.144}
\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{298}{section*.145}
\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{298}{section*.146}
\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{298}{section*.147}
\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{298}{section*.148}
\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{298}{section*.149}
\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{298}{section*.150}
