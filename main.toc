\contentsline {chapter}{\numberline {B}Algorithm For Finding a Three Optic Solution with 45\si {\degree } Gouy Phase Separation between two of the Optics}{150}{appendix.B}
\contentsline {paragraph}{}{151}{section*.172}
\contentsline {paragraph}{}{151}{section*.173}
\contentsline {subsection}{\numberline {B.0.1}Method}{151}{subsection.B.0.1}
\contentsline {paragraph}{Define the target mode at the optic 3.}{152}{section*.174}
\contentsline {paragraph}{Define a set of modes which share the same beam size as the target mode at optic 3 but have varying radii of curvature.}{152}{section*.175}
\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{152}{section*.176}
\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{152}{section*.177}
\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{152}{section*.178}
\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{152}{section*.179}
\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{152}{section*.180}
\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{152}{section*.181}
\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{153}{section*.182}
\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{153}{section*.183}
\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{153}{section*.184}
\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{153}{section*.185}
\contentsline {paragraph}{}{153}{section*.186}
