\contentsline {chapter}{\numberline {B}Algorithm For Finding a Three Optic Solution with 45\si {\degree } Gouy Phase Separation between two of the Optics}{203}{appendix.B}
\contentsline {paragraph}{}{204}{section*.254}
\contentsline {paragraph}{}{204}{section*.255}
\contentsline {subsection}{\numberline {B.0.1}Method}{204}{subsection.B.0.1}
\contentsline {paragraph}{Define the target mode at the optic 3.}{205}{section*.256}
\contentsline {paragraph}{Define a set of modes which share the same beam size as the target mode at optic 3 but have varying radii of curvature.}{205}{section*.257}
\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{205}{section*.258}
\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{205}{section*.259}
\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{205}{section*.260}
\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{205}{section*.261}
\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{205}{section*.262}
\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{205}{section*.263}
\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{206}{section*.264}
\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{206}{section*.265}
\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{206}{section*.266}
\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{206}{section*.267}
\contentsline {paragraph}{}{206}{section*.268}
