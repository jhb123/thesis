\contentsline {chapter}{\numberline {D}Algorithm For Finding a Three Optic Solution with 45\si {\degree } Gouy Phase Separation between two of the Optics}{273}{appendix.D}
\contentsline {paragraph}{}{274}{section*.308}
\contentsline {paragraph}{}{274}{section*.309}
\contentsline {subsection}{\numberline {D.0.1}Method}{274}{subsection.D.0.1}
\contentsline {paragraph}{Define the target mode at the optic 3.}{275}{section*.310}
\contentsline {paragraph}{Define a set of modes which share the same beam size as the target mode at optic 3 but have varying radii of curvature.}{275}{section*.311}
\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{275}{section*.312}
\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{275}{section*.313}
\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{275}{section*.314}
\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{275}{section*.315}
\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{275}{section*.316}
\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{275}{section*.317}
\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{276}{section*.318}
\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{276}{section*.319}
\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{276}{section*.320}
\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{276}{section*.321}
\contentsline {paragraph}{}{276}{section*.322}
