\contentsline {chapter}{\numberline {B}Algorithm For Finding a Three Optic Solution with 45\si {\degree } Gouy Phase Separation between two of the Optics}{68}{appendix.B}
\contentsline {paragraph}{}{69}{section*.80}
\contentsline {paragraph}{}{69}{section*.81}
\contentsline {subsection}{\numberline {B.0.1}Method}{69}{subsection.B.0.1}
\contentsline {paragraph}{Define the target mode at the optic 3.}{70}{section*.82}
\contentsline {paragraph}{Define a set of modes which share the same beam size as the target mode at optic 3 but have varying radii of curvature.}{70}{section*.83}
\contentsline {paragraph}{Propagate the set of modes defined at optic 3 back to the optic 2.}{70}{section*.84}
\contentsline {paragraph}{Define the initial beam parameter and propagate this to optic 1.}{70}{section*.85}
\contentsline {paragraph}{Define a set of modes that have the same beam size as the initial beam at optic 1 but differ in defocus.}{70}{section*.86}
\contentsline {paragraph}{Propagate the modes defined at the optic 1 to optic 2.}{70}{section*.87}
\contentsline {paragraph}{Calculate the difference in optical power between mode i and a mode in the blue-green continuum (e.g. mode j).}{70}{section*.88}
\contentsline {paragraph}{Find a mode in the red-yellow continuum which is closest in size to mode j, call this mode k.}{70}{section*.89}
\contentsline {paragraph}{Calculate the difference in optical power between mode j and mode k at optic 2.}{71}{section*.90}
\contentsline {paragraph}{Calculate the difference in optical power mode k and the target mode at optic 3.}{71}{section*.91}
\contentsline {paragraph}{Calculate the Gouy phase separation of optic 2 and optic 3.}{71}{section*.92}
\contentsline {paragraph}{Repeat for every mode in the blue-green continuum, or until a gouy phase separation of 45\si {degree} has been found.}{71}{section*.93}
\contentsline {paragraph}{}{71}{section*.94}
